{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/app/horloge",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(iPhone|iPad|iPod).*" }],
      "destination": "https://apps.apple.com/app/apple-store/id6771266857?pt=128920490&ct=horloge-qr&mt=8",
      "permanent": false
    },
    {
      "source": "/app/horloge",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*Android.*" }],
      "destination": "https://play.google.com/store/apps/details?id=com.rigsizelive.app&referrer=utm_source%3Dgarmin-watch%26utm_campaign%3Dhorloge-qr",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/googlea07e03d48b2c5ed4",
      "destination": "/googlea07e03d48b2c5ed4.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
